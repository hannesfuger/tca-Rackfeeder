        "objectType": "JavaScript",
        "active": false,
        "sourceLines": [
          "function svgClicked(event) {",
          "if (event.target.tagName === 'circle' || event.target.tagName === 'CIRCLE') {",
          "\t\t         ",
          "\tTcHmi.Symbol.writeEx('%pp%intvar%/pp%', event.target.id, function(data) {",
          "\t\t                     \t",
          "\tvar workpieceIndex =  event.target.id;",
          "    console.log(workpieceIndex);",
          "    ",
          "                                           ",
          "    if (data.error === TcHmi.Errors.NONE) {        ",
          "    const popup = TcHmi.Controls.get('storage_Popup');",
          "    popup.open();",
          "     ",
          "    \tif (popup) {  ",
          "    \tvar userControl = popup.__children[0];     ",
          "    \t",
          " \t\t\tif(userControl){",
          "    \t\t    \t\t",
          "     \t\tTcHmi.Binding.createEx2('%pp%intvar%/pp%', 'Index', userControl);",
          " \t\t\t} ",
          "    \t",
          "     \t}                     ",
          "         ",
          "    } else {",
          "    console.error('Fehler beim Schreiben:', data.error);",
          "    }",
          "                      ",
          " \t});    ",
          "                        ",
          " }",
          " }",
          " ",
          " svgClicked(event);"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
